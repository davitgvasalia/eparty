// Dates the app compares by day (poll start/end, initiative created/promoted) are
// stored as "YYYY-MM-DD" strings, the same format the client already uses.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

enum ChatKind {
  general // the one chat every member is in
  group // made by the administrator, with chosen members
  direct // between two members
}

enum AttachmentKind {
  image
  voice
  file
}

enum InitiativeStage {
  draft
  initiative
}

enum InitiativeStatus {
  pending
  approved
  rejected
}

model District {
  id           String        @id @default(cuid())
  nameKa       String
  nameEn       String
  createdAt    DateTime      @default(now())
  members      Member[]
  applications Application[]
}

model Member {
  id              String           @id @default(cuid())
  nameKa          String
  nameEn          String
  wallet          String           @unique
  role            Role             @default(member)
  districtId      String?
  district        District?        @relation(fields: [districtId], references: [id])
  phone           String?
  email           String?
  // ID photo file names in storage/ids, when the administrator added them directly.
  idFront         String?
  idBack          String?
  joined          String // YYYY-MM-DD
  // Removed members are kept so their past poll votes still count.
  active          Boolean          @default(true)
  initiatives     Initiative[]
  pollVotes       PollVote[]
  initiativeVotes InitiativeVote[]
  likes           InitiativeLike[]
  chats           ChatMember[]
  messages        Message[]
}

model Application {
  id         String   @id @default(cuid())
  nameKa     String
  nameEn     String
  wallet     String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  phone      String
  email      String
  // File names inside storage/ids (outside public/, served to the admin only).
  idFront    String
  idBack     String
  createdAt  DateTime @default(now())
}

model Poll {
  id           String       @id @default(cuid())
  titleKa      String
  titleEn      String
  image        String? // small JPEG data URL
  startsAt     String? // YYYY-MM-DD
  endsAt       String // YYYY-MM-DD
  closedAt     String? // YYYY-MM-DD, set when an admin closes it
  initiativeId String?      @unique
  initiative   Initiative?  @relation(fields: [initiativeId], references: [id])
  createdAt    DateTime     @default(now())
  options      PollOption[]
  votes        PollVote[]
}

model PollOption {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  labelKa  String
  labelEn  String
  position Int
  votes    PollVote[]
}

model PollVote {
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member     @relation(fields: [memberId], references: [id])
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  // Signature of the vote fee transfer to the treasury; unique so one payment buys one vote.
  feeTx     String?    @unique
  createdAt DateTime   @default(now())

  @@id([pollId, memberId])
}

model Initiative {
  id         String           @id @default(cuid())
  titleKa    String
  titleEn    String
  summaryKa  String
  summaryEn  String
  authorId   String
  author     Member           @relation(fields: [authorId], references: [id])
  stage      InitiativeStage  @default(draft)
  status     InitiativeStatus @default(pending)
  createdAt  String // YYYY-MM-DD
  promotedAt String? // YYYY-MM-DD the draft became an initiative
  likes      InitiativeLike[]
  votes      InitiativeVote[]
  poll       Poll?
}

model InitiativeLike {
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([initiativeId, memberId])
}

model InitiativeVote {
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id])
  yes          Boolean
  createdAt    DateTime   @default(now())

  @@id([initiativeId, memberId])
}

model Chat {
  id        String       @id @default(cuid())
  kind      ChatKind
  name      String? // groups only
  // Direct chats: the two member ids, sorted and joined by ":", so a pair has one chat.
  directKey String?      @unique
  createdAt DateTime     @default(now())
  // Time of the last message, for ordering the chat list.
  lastAt    DateTime     @default(now())
  members   ChatMember[]
  messages  Message[]
}

// Who is in a group or direct chat. Everyone is in the general chat, so there a row only
// remembers how far the member has read.
model ChatMember {
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id])
  lastReadAt DateTime @default(now())

  @@id([chatId, memberId])
  @@index([memberId])
}

model Message {
  id          String       @id @default(cuid())
  chatId      String
  chat        Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId    String
  sender      Member       @relation(fields: [senderId], references: [id])
  text        String       @default("")
  createdAt   DateTime     @default(now())
  editedAt    DateTime?
  // Deleted messages stay as a placeholder; their text and files are removed.
  deletedAt   DateTime?
  // Bumped on every change, so clients can fetch only what changed since they last looked.
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]

  @@index([chatId, createdAt])
  @@index([chatId, updatedAt])
}

model Attachment {
  id        String         @id @default(cuid())
  messageId String
  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind      AttachmentKind
  name      String // original file name
  mime      String
  size      Int
  // File name inside storage/chat.
  file      String
  // Voice messages: length in seconds.
  duration  Int?
}

/** A post on the public website's news timeline, written by the administrator. */
model News {
  id        String   @id @default(cuid())
  titleKa   String
  titleEn   String
  bodyKa    String
  bodyEn    String
  image     String? // small JPEG data URL
  date      String // YYYY-MM-DD, shown on the timeline
  createdAt DateTime @default(now())
}

/** Small editable settings stored as JSON, such as the website's texts (key "site"). */
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
