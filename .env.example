# Solana RPC (devnet by default). For production use a dedicated RPC (Helius, QuickNode, ...)
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Admin wallet address. If empty, the admin panel runs in DEMO mode (open to everyone, never in production).
NEXT_PUBLIC_ADMIN_WALLET=

# Treasury wallet that receives a fee for every poll vote, paid from the voter's wallet.
# If empty, voting is free. NEXT_PUBLIC_VOTE_FEE_SOL is the amount (default 0.01).
NEXT_PUBLIC_VOTE_FEE_WALLET=
NEXT_PUBLIC_VOTE_FEE_SOL=0.01

# PostgreSQL connection (docker compose up -d db starts a local one with these credentials)
DATABASE_URL="postgresql://eparty:eparty@localhost:5432/eparty?schema=public"

# Secret for signing session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Folder for applicants' ID photos (outside public/). Back it up and keep it private.
ID_PHOTO_DIR=storage/ids
